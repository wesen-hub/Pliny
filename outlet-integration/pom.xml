<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dcp</groupId>
    <artifactId>dcp-outlet-integration</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>dcp-outlet-integration</name>
    <description>增量消费通道 v2 接线层:控制面端口 ↔ 计算面实现(唯一同时依赖两侧的模块)</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.dcp</groupId>
            <artifactId>dcp-outlet-control</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.dcp</groupId>
            <artifactId>dcp-outlet-worker</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>
        <!-- 复用 control 的内存端口实现(同一套 in-memory 语义,避免测试重复实现) -->
        <dependency>
            <groupId>com.dcp</groupId>
            <artifactId>dcp-outlet-control</artifactId>
            <version>2.0.0-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      依赖方向:integration → {control, worker};control 与 worker 互不依赖(只依赖 SDK)。
      换成"HTTP 下发到远程 worker"时,只替换本模块的适配器实现。
    -->
</project>

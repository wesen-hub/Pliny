<?xml version="1.0" encoding="UTF-8"?>
<!--
  dcp-tag-task —— 打标消费底座任务(微服务架构方案 N8, 维度④ 打标引擎)。

  定位: 打标任务的底座形态 —— TagLogic(@ConsumerLogicDef("tag-engine@1.0.0"))
  实现二级 SPI ConsumerLogic, 由 dcp-outlet-rt 的 JarLogicLoader 从逻辑仓库
  (logic-repo/tag-engine/1.0.0.jar) 加载运行。切流后替代 Flink 流执行(dcp-tagstream,
  P2 后退役), 获得防双消费/扩缩容等底座能力。

  语义对齐(与切流前 dcp-tagstream 同构):
    · 每事件(INSERT/UPDATE/SNAPSHOT)按发布快照求值(平铺规则 + 规则流 hit/miss 控制流,
      与 StreamEvaluator 同语义), 命中双写 Redis tag:online:{entity} + MySQL
      tag_fact_view / tag_notify(task_mode='stream', 与切流前一致);
    · DELETE 事件 = 清在线标签(Redis hdel) + 删投影行(fact_view);
    · 窗口派生(derived): 内存滚动窗口(按 entity 近似累计, 语义等价 Flink 版
      "事件级近似", 无 keyed 重分区 —— 同 entity 跨分区事件分实例累计, 精度等级一致)。

  代码组织铁律(方案 §8.2/§8.3):
    - fat jar 自足: dcp-tag-kie(drools/jackson) + jedis + mysql 驱动打入本 jar;
      二级 SPI 契约(outlet-sdk)由父加载器(dcp-outlet-rt 的 ConsumerLogic 类加载器)提供;
    - 无 Spring 装配: 全部手工组装; slf4j 由宿主提供(provided);
    - 失败要抛: 主链路(在线层/投影)写失败必须抛异常, 平台据此不提交→重试→死信;
      tag_notify 审计写失败仅告警(与 StreamSinks 一致, 审计不阻断主链路)。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dcp</groupId>
    <artifactId>dcp-tag-task</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>dcp-tag-task</name>
    <description>打标消费底座任务:TagLogic(@ConsumerLogicDef tag-engine) 按发布快照求值, 双写 Redis 在线层 + MySQL 投影层</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jedis.version>5.1.2</jedis.version>
    </properties>

    <dependencies>
        <!-- 二级 SPI 契约(父加载器提供: dcp-outlet-rt 的 ConsumerLogic 类加载器; 这里 compile 仅为单测可运行, shade 后父优先加载) -->
        <dependency>
            <groupId>com.dcp</groupId>
            <artifactId>dcp-outlet-sdk</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>
        <!-- 打标编译库(规则→DRL / 动态 Fact / KieBase / TagActions; drools+jackson 随本依赖传递并打入本 jar) -->
        <dependency>
            <groupId>com.dcp</groupId>
            <artifactId>dcp-tag-kie</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- 在线层(Redis tag:online:{entity}; 与 dcp-tagstream 同版本) -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
        </dependency>
        <!-- 投影层(tag_fact_view/tag_notify; 与 dcp-tagstream 同版本) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>
        <!-- 打标事件流发射(tag 契约订阅推送底座任务 dcp-sub-push 的数据源) -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.7.0</version>
        </dependency>
        <!-- 日志门面(provided, 宿主统一管理日志后端) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
            <scope>provided</scope>
        </dependency>
        <!-- 测试(sdk testkit: FakeBatch/FakeInitContext/FakeConsumerContext/FakeRecord) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>dcp-tag-task</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- fat jar: 二级 SPI 服务声明合并(与 dcp-outlet-rt/dcp-synclink 项目惯例一致) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- 排除依赖 jar 的签名文件: shade 改写 Manifest 后, URLClassLoader 读
                                 META-INF/services 时 JarVerifier 校验 *.SF/*.DSA/*.RSA 会抛
                                 SecurityException(Invalid signature file digest) -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

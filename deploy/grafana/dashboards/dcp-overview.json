{
  "schemaVersion": 39,
  "title": "DCP 平台监控",
  "uid": "dcp-overview",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "tags": ["dcp", "governance"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "JVM 堆内存使用率",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / sum(jvm_memory_max_bytes{area=\"heap\"}) * 100",
          "legendFormat": "堆使用率"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "线程数",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_threads_live_threads)",
          "legendFormat": "线程数"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GC 累计次数",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(jvm_gc_pause_seconds_count[$__rate_interval])",
          "legendFormat": "{{gc}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP 请求速率(QPS)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[$__rate_interval])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU 使用率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "连接池(HikariCP)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending"
        }
      ]
    }
  ]
}

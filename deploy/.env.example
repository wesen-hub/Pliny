# 最小集群部署环境变量(复制为 deploy/.env 后填实际值; 三机同值)
# 阿里云 RDS MySQL(元库主库, 公网 + 白名单开通后填)
RDS_HOST=rm-bp19av6aigxn7190c.mysql.rds.aliyuncs.com
RDS_USER=dcp
RDS_PASSWORD=CHANGE_ME

# 应用加解密/鉴权(三机与本地 demo 同值)
PLATFORM_ENC_KEY=dev-enc-key-0123456789abcdef
JWT_SECRET=dcp-jwt-secret-0123456789abcdef0123456789

# agent 注册码(一次性, 首启后由平台签发流程替代)
DCP_AGENT_REGISTER_CODE=

# 腾讯云 MySQL 从库 root 密码
MYSQL_SLAVE_ROOT_PASSWORD=dcp-slave-root

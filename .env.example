# 复制为 .env 后启动: cp .env.example .env
# 安全要求(H3): 密钥缺失或为公开默认值时 backend 拒绝启动。
# 生产环境请用随机值, 生成方式示例: openssl rand -hex 32

# JWT 签名密钥(HS256, ≥32 字节)
JWT_SECRET=change-me-0123456789abcdef0123456789abcdef

# 数据源密码 AES-GCM 加密密钥(任意长度, SHA-256 派生)
PLATFORM_ENC_KEY=change-me-0123456789abcdef0123456789abcdef

# 栈内 MySQL root 口令(演示初始值; 生产务必修改, 各服务连接口令均以此为唯一事实源)
MYSQL_ROOT_PASSWORD=root123
